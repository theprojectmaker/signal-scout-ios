+    private func ensurePeerAndSession(_ name: String) -> MCPeerID {
+        // Reuse ONE peer id + session for BOTH advertising and discovery so the invite/accept
+        // identities always match. (Patched: the stock module created a new peer id + session in
+        // each of startAdvertise/startDiscovery and disconnected the other's — so a device doing
+        // both roles invited as one identity but accepted as another, and peers never connected.)
+        if self.myPeerId == nil { self.myPeerId = MCPeerID(displayName: name) }
+        if self.session == nil {
+            self.session = MCSession(peer: self.myPeerId!, securityIdentity: nil, encryptionPreference: .required)
+            self.session?.delegate = self
+        }
+        return self.myPeerId!
+    }

{
  "expo": {
    "name": "Signal Scout",
    "slug": "signal-scout",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "signalscout",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b0f17",
    "ios": {
      "bundleIdentifier": "com.solyapps.signalscout",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true
      }
    },
    "android": {
      "package": "com.solyapps.signalscout",
      "adaptiveIcon": {
        "backgroundColor": "#0b0f17",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": []
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0f17",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#34C759"
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "@kesha-antonov/react-native-background-downloader",
      "react-native-blob-util",
      [
        "expo-image-picker",
        {
          "photosPermission": "Signal Scout lets you pick a photo to ask the on-device AI about it. Photos stay on your device.",
          "cameraPermission": "Signal Scout lets you take a photo to ask the on-device AI about it. Photos stay on your device."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Signal Scout uses the camera light for the flashlight."
        }
      ],
      "expo-brightness",
      "expo-sharing",
      [
        "expo-nearby-connections",
        {
          "bonjourServicesName": "sigscout-share",
          "localNetworkUsagePermissionText": "Signal Scout uses the local network to share files with a nearby device — no internet needed.",
          "bluetoothUsagePermissionText": "Signal Scout uses Bluetooth to find and connect to a nearby device for offline file sharing."
        }
      ],
      "./plugins/with-bonjour-udp.js"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "solomonsasson",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e17cf64c-38e6-4161-90c7-44f1ff546fea"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e17cf64c-38e6-4161-90c7-44f1ff546fea"
    }
  }
}
